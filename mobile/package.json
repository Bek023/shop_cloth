{
  "name": "nasiyachi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts supabase/functions/_shared/*.test.ts",
    "build:web": "EXPO_OFFLINE=1 expo export --platform web",
    "e2e": "npm run build:web && node e2e/web-smoke.js dist e2e-shots",
    "test:db": "supabase/tests/run.sh",
    "check:functions": "cd supabase/functions && npx --yes deno@2.5.6 check telegram-bot/index.ts daily-reminders/index.ts"
  },
  "private": true
}
