# Edge Function secrets. Set them with: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.
# From @BotFather. Never commit it, never put it in the app.
TELEGRAM_BOT_TOKEN=
# Any long random string (openssl rand -hex 32). Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Any long random string. pg_cron sends it to daily-reminders; store the same value in Vault as cron_secret.
CRON_SECRET=
