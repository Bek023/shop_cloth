# Copy to .env.local and fill in. Leave empty to run in demo mode (no server).
# Supabase Dashboard > Project Settings > API. The anon key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Bot username without @, e.g. NasiyachiBot
EXPO_PUBLIC_TELEGRAM_BOT=
